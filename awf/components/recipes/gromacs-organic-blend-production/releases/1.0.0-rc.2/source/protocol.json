    {"id": "relax", "ensemble": "NPT", "duration_ns": 5.0, "temperature_K": 300.0, "pressure_bar": 1.0},
    {"id": "anneal_01_03", "ensemble": "NPT", "cycles": 3, "duration_ns_each": 5.0, "segments_ns": [0.5, 1.0, 1.0, 2.5], "temperature_K": [300, 500, 500, 300], "pressure_bar": 1.0},
    {"id": "hold", "ensemble": "NPT", "duration_ns": 10.0, "temperature_K": 300.0, "pressure_bar": 1.0}
  ],
  "compression_runtime_defaults": {
    "dt_ps": 0.002,
